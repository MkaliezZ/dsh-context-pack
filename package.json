{
  "name": "@mkaliezz/dsh-context-pack",
  "version": "0.2.0",
  "description": "Deterministic privacy-aware repository context packs for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test lib/tests/*.test.js",
    "check": "npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MkaliezZ/dsh-context-pack.git"
  }
}
